{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", "^0.8.28"],
    "func-visibility": ["warn", { "ignoreConstructors": true }],
    "max-line-length": ["warn", 120],
    "no-empty-blocks": "error",
    "no-unused-vars": "error",
    "reentrancy": "error",
    "avoid-suicide": "error",
    "avoid-sha3": "warn"
  }
}
