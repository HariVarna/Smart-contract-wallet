{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@scw/types": ["../types/src/index.ts"],
      "@scw/contracts": ["./src/index.ts"],
      "@scw/wallet-core": ["../wallet-core/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
