# ==============================================================================
# SMART CONTRACT WALLET - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice:
# 1. Never commit real private keys or production credentials to source control.
# 2. Never expose private keys in NEXT_PUBLIC_ variables.
# 3. Only use deterministic, well-known test keys for local Anvil development.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Blockchain Network Configuration
# Default: Local Anvil Node
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME="Anvil Localnet"
NEXT_PUBLIC_RPC_URL="http://127.0.0.1:8545"

# Optional Block Explorer URL
NEXT_PUBLIC_BLOCK_EXPLORER_URL=""

# Local Anvil Configuration
ANVIL_PORT=8545
ANVIL_CHAIN_ID=31337
ANVIL_BLOCK_TIME=1
